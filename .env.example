# Supabase (required for cloud interest saves + Hall of Fame)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Optional override (defaults to $VITE_SUPABASE_URL/functions/v1)
# VITE_SUPABASE_FUNCTIONS_URL=

# Optional — bump to force clients to re-download /sprites after art changes.
# VITE_SPRITE_VER=20260807b

# Edge Function secrets (set in Supabase, never in this file):
#   SUPABASE_SERVICE_ROLE_KEY
#   ADMIN_EXPORT_SECRET
